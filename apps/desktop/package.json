{
  "name": "@neondeck/desktop",
  "private": true,
  "version": "0.2.0",
  "description": "NEONDECK desktop shell",
  "author": "NEONDECK contributors",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist --out-extension:.js=.cjs --log-level=warning",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "org.neondeck.app",
    "productName": "NEONDECK",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**"
    ],
    "extraResources": [
      {
        "from": "../tv/dist",
        "to": "tv"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "NEONDECK",
      "artifactName": "NEONDECK-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "@neondeck/core": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
