{
  "name": "neondeck",
  "private": true,
  "version": "0.2.0",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @neondeck/tv",
